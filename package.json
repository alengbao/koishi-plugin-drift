{
  "name": "koishi-plugin-drift",
  "version": "0.1.0",
  "description": "A small persistent survival game for Koishi.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alengbao/koishi-plugin-drift.git"
  },
  "bugs": {
    "url": "https://github.com/alengbao/koishi-plugin-drift/issues"
  },
  "keywords": [
    "koishi",
    "koishi-plugin",
    "game",
    "survival",
    "drift"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-content.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.16"
  },
  "peerDependencies": {
    "koishi": "^4.18.11"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@koishijs/plugin-database-sqlite": "^4.7.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "13.1.5",
    "@types/node": "^24.1.0",
    "koishi": "^4.18.11",
    "semantic-release": "^24.2.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod-to-json-schema": "^3.24.6"
  },
  "koishi": {
    "description": {
      "zh": "一个持久化的文字生存游戏。"
    }
  }
}
